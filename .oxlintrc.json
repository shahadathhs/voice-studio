{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 300
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipComments": true
      }
    ],
    "max-params": [
      "error",
      {
        "max": 5
      }
    ],
    "complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "eqeqeq": "error",
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "target",
    ".husky",
    "desktop/.svelte-check",
    "site/.next",
    "desktop/src-tauri",
    "docs/design/mockups",
    "pnpm-lock.yaml"
  ]
}
